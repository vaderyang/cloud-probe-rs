+        mgr.start();
+        let pipeline = mgr.pipeline.as_ref().unwrap().clone();
+        let mut latencies = Vec::new();
+        for _ in 0..1000 {
+            std::thread::sleep(Duration::from_millis(2));
+            let hdr = PacketHeader {
+                ts_sec: 0,
+                ts_usec: 0,
+                caplen: 64,
+                len: 64,
+            };
+            let sent = Instant::now();
+            PipelineSink {
+                ring: &mut pipeline.producer.lock(),
+                alloc: &pipeline.alloc,
+                task_index: 0,
+            }
+            .on_packet(&hdr, &[0; 64], 1);
+            latencies.push(
+                rx.recv_timeout(Duration::from_secs(1))
+                    .unwrap()
+                    .duration_since(sent)
+                    .as_nanos(),
+            );
+        }
+        mgr.stop();
+        latencies.sort_unstable();
+        println!(
+            "LATENCY p50_ns={} p95_ns={} p99_ns={} max_ns={}",
+            latencies[500], latencies[950], latencies[990], latencies[999]
+        );
+    }
