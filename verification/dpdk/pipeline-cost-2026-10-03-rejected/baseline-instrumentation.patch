+            assert_eq!(row["stats"]["output"]["fwd_packets"]["packets"], delivered);
+            assert_eq!(row["stats"]["pipeline_buffer"]["mem_used"], 0);
+            assert_eq!(row["stats"]["pipeline_buffer"]["ring_used"], 0);
+        }
+    }
+    #[test]
+    #[ignore]
+    fn pipeline_latency_probe() {
+        use std::time::{Duration, Instant};
+        struct TimedOutput(std::sync::mpsc::Sender<Instant>);
+        impl Output for TimedOutput {
+            fn send_packet(&mut self, _: &PacketHeader, _: &[u8], _: i32) -> i32 {
+                self.0.send(Instant::now()).unwrap();
+                0
+            }
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let mut mgr = pipeline_manager(dir.path());
+        let (tx, rx) = std::sync::mpsc::channel();
